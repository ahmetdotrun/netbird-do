diff --git a/client/firewall/uspfilter/forwarder/host.go b/client/firewall/uspfilter/forwarder/host.go
new file mode 100644
index 0000000..c1624df
--- /dev/null
+++ b/client/firewall/uspfilter/forwarder/host.go
@@ -0,0 +1,30 @@
+package forwarder
+
+import (
+	"context"
+	"net"
+	"sync/atomic"
+)
+
+type hostDialer struct {
+	dial func(context.Context, string, string) (net.Conn, error)
+}
+
+var sandboxDialer atomic.Pointer[hostDialer]
+
+// SetHostDialContext supplies host egress for socketless sandbox environments.
+// A nil dialer restores normal operating-system sockets. Configure before use.
+func SetHostDialContext(dial func(context.Context, string, string) (net.Conn, error)) {
+	if dial == nil {
+		sandboxDialer.Store(nil)
+		return
+	}
+	sandboxDialer.Store(&hostDialer{dial: dial})
+}
+
+func dialHostContext(ctx context.Context, network, address string) (net.Conn, error) {
+	if host := sandboxDialer.Load(); host != nil {
+		return host.dial(ctx, network, address)
+	}
+	return (&net.Dialer{}).DialContext(ctx, network, address)
+}
